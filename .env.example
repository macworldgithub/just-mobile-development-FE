# -----------------------------------------------------------------------------
# JUSTMOBILE FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Add these variables to your Vercel Project Settings -> Environment Variables
# -----------------------------------------------------------------------------

# Backend API URL for server-side proxy rewrites (e.g. your deployed BE on Vercel)
BACKEND_URL=https://your-backend-project.vercel.app

# Public Backend API URL for direct client-side fetch calls (optional)
NEXT_PUBLIC_API_URL=https://your-backend-project.vercel.app
